<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="USJRLedger.Views.Adviser.IncomeTrailPage"
             Title="Income Trail"
             BackgroundColor="#f8f9fa">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="15">

        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Select School Year" FontSize="14" TextColor="Gray" Margin="5,0,0,0"/>
            <Border StrokeThickness="0" BackgroundColor="White" Padding="0" HeightRequest="50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>
                <Picker x:Name="SchoolYearPicker"
                        Title="Select School Year"
                        SelectedIndexChanged="OnSchoolYearChanged"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#333"
                        TitleColor="Gray"/>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="IncomeTrailList" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No income found for this school year." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" 
                            Padding="15" 
                            StrokeThickness="0" 
                            BackgroundColor="White">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="5">

                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding Detail}" 
                                   FontSize="16" 
                                   TextColor="Black" 
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>

                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding AmountString}"
                                   TextColor="#28a745" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"/>

                            <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                         Orientation="Horizontal" 
                                         Spacing="5">

                                <Label Text="{Binding DateString}" 
                                       FontSize="12" 
                                       TextColor="Gray"/>

                                <Label Text="•" TextColor="LightGray"/>

                                <Label Text="Sent by:" 
                                       FontSize="12" 
                                       TextColor="Gray"/>
                                <Label Text="{Binding SenderName}" 
                                       FontSize="12" 
                                       TextColor="#555"
                                       FontAttributes="Bold"/>
                            </StackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>