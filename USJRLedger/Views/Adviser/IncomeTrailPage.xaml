<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="USJRLedger.Views.Adviser.IncomeTrailPage"
             Title="Income Trail">

    <Grid RowDefinitions="Auto, *" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <Label Text="Select School Year" FontSize="14" TextColor="Gray" Margin="5,0,0,0"/>

            <Border Stroke="Transparent"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0"
                    HeightRequest="50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>

                <Picker x:Name="SchoolYearPicker"
                        Title="Select School Year"
                        SelectedIndexChanged="OnSchoolYearChanged"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#333"
                        TitleColor="Gray"
                        BackgroundColor="Transparent"/>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="IncomeTrailList">
            <CollectionView.EmptyView>
                <Label Text="No income found for this school year." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="LightGray" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 10" 
                            Padding="15" 
                            Margin="0,5"
                            BackgroundColor="White">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding CreatedDate, StringFormat='{0:MMM dd, yyyy}'}" 
                                       FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Detail}" 
                                       FontSize="16" TextColor="Black" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                                   Text="{Binding Amount, StringFormat='₱ {0:N2}'}"
                                   TextColor="Green" FontSize="16" FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>