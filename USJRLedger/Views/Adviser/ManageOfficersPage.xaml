<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:USJRLedger.Converters"
             x:Class="USJRLedger.Views.Adviser.ManageOfficersPage"
             Title="Manage Officers">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:BoolToActionConverter x:Key="BoolToActionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" 
                             Spacing="20">

            <Border Stroke="Gray"
                    StrokeThickness="1" 
                    Padding="15"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="FormTitleLabel" 
                           Text="Add New Officer" 
                           FontSize="20" 
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Full Name" />
                        <Entry x:Name="NameEntry" 
                               Placeholder="Enter officer's full name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Student ID (Username)" />
                        <Entry x:Name="StudentIdEntry" 
                               Placeholder="Enter student ID" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Position" />
                        <Entry x:Name="PositionEntry"
                               Placeholder="Enter position (e.g. President)" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" />
                        <Entry x:Name="PasswordEntry" 
                               Placeholder="Leave blank to keep existing password" 
                               IsPassword="True" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10" 
                                           HorizontalOptions="End">

                        <Button x:Name="CancelButton"
                                Text="Cancel"
                                Clicked="OnCancelEditClicked"
                                BackgroundColor="Gray"
                                TextColor="White"
                                CornerRadius="6"
                                IsVisible="False"/>

                        <Button x:Name="SaveButton"
                                Text="Add Officer"
                                Clicked="OnSaveOfficerClicked"
                                BackgroundColor="#28a745"
                                TextColor="White"
                                CornerRadius="6" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="Gray" 
                    StrokeThickness="1" 
                    Padding="15" 
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout 
                    Spacing="15">
                    <Label Text="Current Officers" 
                           FontSize="20"
                           FontAttributes="Bold" />

                    <ListView x:Name="OfficersListView" 
                              HasUnevenRows="True" 
                              SeparatorVisibility="None" 
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Border Stroke="Gray" 
                                            StrokeThickness="1"
                                            Padding="10" Margin="5" 
                                            StrokeShape="RoundRectangle 8">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                            <Label Grid.Row="0" 
                                                   Text="{Binding Name}"
                                                   FontAttributes="Bold" FontSize="16" />
                                            <Label Grid.Row="1" 
                                                   Text="{Binding Position}" 
                                                   FontSize="14" 
                                                   TextColor="Gray" />

                                            <StackLayout Grid.Row="2"
                                                         Orientation="Horizontal" 
                                                         Spacing="5">
                                                <Label Text="Status:" 
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" />
                                            </StackLayout>

                                            <StackLayout Grid.Row="3" Orientation="Horizontal"
                                                         Spacing="10" 
                                                         HorizontalOptions="End" 
                                                         Margin="0,5,0,0">

                                                <Button Text="Edit"
                                                        BackgroundColor="green"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        HeightRequest="35"
                                                        FontSize="12"
                                                        Clicked="OnEditOfficerClicked"
                                                        BindingContext="{Binding .}" />

                                                <Button Text="{Binding IsActive, Converter={StaticResource BoolToActionConverter}}"
                                                        BackgroundColor="#8B0000"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        HeightRequest="35"
                                                        FontSize="12"
                                                        Clicked="OnToggleStatusClicked"
                                                        BindingContext="{Binding .}" />

                                                <Button Text="Delete"
                                                        BackgroundColor="#D32F2F"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        HeightRequest="35"
                                                        FontSize="12"
                                                        Clicked="OnDeleteOfficerClicked"
                                                        BindingContext="{Binding .}" />
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>