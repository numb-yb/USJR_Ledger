<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="USJRLedger.Views.Adviser.ExpenseBreakdownPage"
             Title="Expense Breakdown"
             BackgroundColor="#f8f9fa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="5">
                <Label Text="Select School Year"
                       FontSize="14" 
                       TextColor="Gray" 
                       Margin="5,0,0,0"/>
                <Border StrokeThickness="0" 
                        BackgroundColor="White" 
                        Padding="0" 
                        HeightRequest="50">
                    <Border.StrokeShape>
                        <RoundRectangle 
                            CornerRadius="10" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="0,2"
                                Radius="5" 
                                Opacity="0.1" />
                    </Border.Shadow>
                    <Picker x:Name="SchoolYearPicker"
                            Title="Select School Year"
                            SelectedIndexChanged="OnSchoolYearChanged"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#333"
                            TitleColor="Gray"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5" 
                                 HorizontalOptions="Center">
                <Label Text="Total Approved Expenses"
                       FontSize="14" 
                       TextColor="Gray" 
                       HorizontalOptions="Center"/>
                <Label x:Name="GrandTotalLabel" 
                       Text="&#x20B1; 0.00" 
                       FontSize="36" 
                       FontAttributes="Bold" 
                       TextColor="#d9534f" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" 
                     Color="#e0e0e0"
                     Margin="0,5"/>

            <VerticalStackLayout Spacing="15">

                <VerticalStackLayout 
                    Spacing="5">
                    <Label Text="General Expenses (Click to View)"
                           FontSize="14" 
                           TextColor="Gray" 
                           FontAttributes="Bold"/>
                    <Border StrokeThickness="0" 
                            BackgroundColor="White"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" 
                                    Offset="0,4" 
                                    Radius="8" 
                                    Opacity="0.05"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGeneralExpenseTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   Text="General Expenses Total" 
                                   VerticalOptions="Center" 
                                   FontSize="16" 
                                   TextColor="#333"/>
                            <Label x:Name="GeneralTotalLabel" 
                                   Grid.Column="1" 
                                   Text="&#x20B1; 0.00"
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#d9534f"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout 
                    Spacing="5">
                    <Label Text="Event Expenses (Click to View)" 
                           FontSize="14" 
                           TextColor="Gray" 
                           FontAttributes="Bold"/>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Offset="0,4"
                                    Radius="8"
                                    Opacity="0.05"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Tapped="OnEventExpenseSummaryTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   Text="Event Expenses Total" 
                                   VerticalOptions="Center" 
                                   FontSize="16" 
                                   TextColor="#333"/>
                            <Label x:Name="EventTotalLabel" 
                                   Grid.Column="1" 
                                   Text="&#x20B1; 0.00" 
                                   FontAttributes="Bold"
                                   FontSize="18" 
                                   TextColor="#d9534f"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" 
                                 Margin="0,15,0,0">
                <Label Text="Rejected Expenses" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#dc3545"/>

                <CollectionView x:Name="RejectedExpensesList" 
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No rejected expenses found." 
                               HorizontalOptions="Center" 
                               TextColor="Gray" 
                               FontSize="14" 
                               Margin="0,20,0,0"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#ffcccc" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 10" 
                                    Padding="15" 
                                    Margin="0,0,0,10" 
                                    BackgroundColor="#fff5f5">

                                <Grid RowDefinitions="Auto, Auto, Auto" 
                                      ColumnDefinitions="*, Auto" 
                                      RowSpacing="5">

                                    <Label Grid.Row="0" Grid.Column="0" 
                                           Text="{Binding Detail}" 
                                           FontAttributes="Bold" 
                                           FontSize="16" 
                                           TextColor="#333"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding Amount, StringFormat='&#x20B1; {0:N2}'}" 
                                           FontAttributes="Bold" 
                                           TextColor="#dc3545" 
                                           FontSize="16"
                                           HorizontalTextAlignment="End"/>

                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                           FontSize="13" 
                                           TextColor="#555">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Sent by: " />
                                                <Span Text="{Binding SenderName}"
                                                      FontAttributes="Bold" 
                                                      TextColor="#d9534f"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <StackLayout Grid.Row="2"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2" 
                                                 Orientation="Horizontal" 
                                                 Spacing="8">
                                        <Label Text="{Binding DateString}" 
                                               FontSize="12" 
                                               TextColor="Gray"/>
                                        <Label Text="|" 
                                               TextColor="LightGray"/>
                                        <Label Text="{Binding Category}" 
                                               FontSize="12" 
                                               TextColor="Gray" 
                                               FontAttributes="Italic"/>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>