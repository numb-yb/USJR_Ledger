<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="USJRLedger.Views.Adviser.ExpenseBreakdownPage"
             Title="Expense Breakdown">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Select School Year" FontSize="14" TextColor="Gray" Margin="5,0,0,0"/>

            <Border Stroke="Transparent"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0"
                    HeightRequest="50"
                    Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>

                <Picker x:Name="SchoolYearPicker"
                        Title="Select School Year"
                        SelectedIndexChanged="OnSchoolYearChanged"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#333"
                        TitleColor="Gray"
                        BackgroundColor="Transparent"/>
            </Border>

            <VerticalStackLayout Spacing="5" Margin="0,10">
                <Label Text="Total Approved Expenses" 
                       FontSize="16" 
                       TextColor="Gray" 
                       HorizontalOptions="Center"/>
                <Label x:Name="GrandTotalLabel"
                       FontSize="36" 
                       FontAttributes="Bold" 
                       TextColor="#d9534f" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#e0e0e0" Margin="0,5"/>

            <Label Text="General Expenses (Click to View)" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#333"/>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    BackgroundColor="#f8f9fa"
                    Padding="15"
                    StrokeShape="RoundRectangle 10">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGeneralExpenseTapped" NumberOfTapsRequired="1" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" 
                           Text="General Expenses Total" 
                           VerticalOptions="Center"
                           FontSize="16"/>
                    <Label Grid.Column="1" 
                           x:Name="GeneralTotalLabel"
                           FontAttributes="Bold" 
                           FontSize="16"
                           TextColor="#d9534f"/>
                </Grid>
            </Border>

            <Label Text="Event Expenses (Click to View)" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#333" 
                   Margin="0,10,0,0"/>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    BackgroundColor="#f8f9fa"
                    Padding="15"
                    StrokeShape="RoundRectangle 10">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEventExpenseSummaryTapped" NumberOfTapsRequired="1" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" 
                           Text="Event Expenses Total" 
                           VerticalOptions="Center"
                           FontSize="16"/>
                    <Label Grid.Column="1" 
                           x:Name="EventTotalLabel"
                           FontAttributes="Bold" 
                           FontSize="16"
                           TextColor="#d9534f"/>
                </Grid>
            </Border>

            <Label Text="Rejected Expenses" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="Red"
                   Margin="0,15,0,0"/>

            <CollectionView x:Name="RejectedExpensesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#ffcccc"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="15"
                                Margin="0,5"
                                BackgroundColor="#fff5f5">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Detail}" 
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="#333"/>
                                    <Label Text="{Binding DateString}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>
                                    <Label Text="{Binding Category}" 
                                           FontSize="10" 
                                           TextColor="DarkGray" 
                                           FontAttributes="Italic"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" 
                                       Text="{Binding Amount, StringFormat='₱ {0:N2}'}" 
                                       FontAttributes="Bold" 
                                       TextColor="Red" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No rejected expenses." 
                           HorizontalOptions="Center"
                           TextColor="Gray" 
                           FontSize="12"
                           Margin="0,10"/>
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>  