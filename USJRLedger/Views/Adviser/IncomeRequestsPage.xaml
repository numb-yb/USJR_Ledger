<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="USJRLedger.Views.Adviser.IncomeRequestsPage"
             Title="Income Requests"
             BackgroundColor="#f8f9fa">

    <VerticalStackLayout Padding="15" Spacing="15">

        <Label Text="Pending Income Requests" 
               FontSize="20" 
               FontAttributes="Bold" 
               TextColor="Black"/>

        <Label x:Name="NoIncome" 
               Text="No pending income requests"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="16"
               TextColor="Gray"
               IsVisible="False" />

        <ListView x:Name="IncomeList" 
                  HasUnevenRows="True" 
                  SeparatorVisibility="None" 
                  SelectionMode="None"
                  BackgroundColor="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Border Margin="0,0,0,15" 
                                Padding="15" 
                                StrokeThickness="0" 
                                BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="8">

                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" 
                                           Text="{Binding Detail}" 
                                           FontAttributes="Bold" 
                                           FontSize="16" 
                                           TextColor="Black"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Column="1" 
                                           Text="{Binding AmountString}" 
                                           TextColor="#28a745" 
                                           FontAttributes="Bold" 
                                           FontSize="16"
                                           HorizontalTextAlignment="End"/>
                                </Grid>

                                <Label Grid.Row="1" 
                                       FontSize="13" 
                                       TextColor="#555">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Requested by: " />
                                            <Span Text="{Binding RequestedBy}" FontAttributes="Bold"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label Grid.Row="2" 
                                       FontSize="12" 
                                       TextColor="Gray">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DateRequested}" />
                                            <Span Text=" • " />
                                            <Span Text="{Binding Category}" />
                                            <Span Text=" • " />
                                            <Span Text="{Binding Event}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Grid Grid.Row="3" 
                                      ColumnDefinitions="Auto, *, *" 
                                      ColumnSpacing="10" 
                                      Margin="0,10,0,0">

                                    <Button Grid.Column="0"
                                            Text="View Receipt"
                                            FontSize="12"
                                            HeightRequest="38"
                                            Padding="15,0"
                                            BackgroundColor="Transparent"
                                            TextColor="#6f42c1"
                                            BorderColor="#6f42c1"
                                            BorderWidth="1"
                                            CornerRadius="8"
                                            IsVisible="{Binding HasReceipt}"
                                            Clicked="OnViewReceiptClicked"/>

                                    <Button Grid.Column="1"
                                            Text="Reject"
                                            FontSize="14"
                                            HeightRequest="40"
                                            CornerRadius="8"
                                            BackgroundColor="#dc3545"
                                            TextColor="White"
                                            Clicked="OnRejectClicked"/>

                                    <Button Grid.Column="2"
                                            Text="Approve"
                                            FontSize="14"
                                            HeightRequest="40"
                                            CornerRadius="8"
                                            BackgroundColor="#28a745"
                                            TextColor="White"
                                            Clicked="OnApproveClicked"/>
                                </Grid>

                            </Grid>
                        </Border>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>