<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:USJRLedger.Converters"
             x:Class="USJRLedger.Views.Admin.ViewOrganizationsPage"
             Title="Organizations"
             BackgroundColor="#f5f5f7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToActionConverter x:Key="BoolToActionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="15">

        <Label Grid.Row="0" 
               Text="All Organizations"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="Black"/>

        <CollectionView Grid.Row="1"
                        x:Name="OrganizationsListView"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No organizations found." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="LightGray"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="White"
                            Padding="15"
                            Margin="0,0,0,10">

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="Black"/>

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Department}"
                                   FontSize="14"
                                   TextColor="Gray"
                                   Margin="0,2,0,0"/>

                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="5" Margin="0,5,0,0">
                                <Label Text="Status:" FontAttributes="Bold" FontSize="12" TextColor="Black"/>
                                <Label Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                       TextColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" 
                                                 Spacing="8" VerticalOptions="Center">

                                <Button Text="View"
                                        Clicked="OnViewDetailsClicked"
                                        BackgroundColor="#28a745"
                                        TextColor="White"
                                        FontSize="12"
                                        HeightRequest="35"
                                        CornerRadius="5"
                                        WidthRequest="90"/>

                                <Button Text="{Binding IsActive, Converter={StaticResource BoolToActionConverter}}"
                                        Clicked="OnUpdateStatusClicked"
                                        BackgroundColor="#dc3545"
                                        TextColor="White"
                                        FontSize="12"
                                        HeightRequest="35"
                                        CornerRadius="5"
                                        WidthRequest="90"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>