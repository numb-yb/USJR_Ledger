<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:USJRLedger.Converters"
             x:Class="USJRLedger.Views.Admin.ManageAdvisersPage"
             Title="Manage Advisers">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:BoolToActionConverter x:Key="BoolToActionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame BorderColor="Gray" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="FormTitleLabel" 
                           Text="Add New Adviser" 
                           FontSize="20" 
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Full Name" />
                        <Entry x:Name="NameEntry" Placeholder="Enter adviser's full name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Employee ID (Username)" />
                        <Entry x:Name="UsernameEntry" Placeholder="Enter employee ID" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" />
                        <Entry x:Name="PasswordEntry" 
                               Placeholder="Enter temporary password" 
                               IsPassword="True" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Organization" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="OrganizationPicker"
                                    Title="Select organization"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedIndexChanged="OnOrganizationSelected" />

                            <Button x:Name="ClearOrganizationButton"
                                    Text="Clear"
                                    BackgroundColor="Transparent"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    IsVisible="False"
                                    Clicked="OnClearOrganizationClicked"
                                    Grid.Column="1"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                        <Button x:Name="CancelButton"
                                Text="Cancel"
                                Clicked="OnCancelEditClicked"
                                BackgroundColor="Gray"
                                TextColor="White"
                                CornerRadius="6"
                                IsVisible="False"/>

                        <Button x:Name="SaveButton"
                                Text="Add Adviser"
                                Clicked="OnSaveAdviserClicked"
                                BackgroundColor="#28a745"
                                TextColor="White"
                                CornerRadius="6" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="Gray" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Existing Advisers" FontSize="20" FontAttributes="Bold" />

                    <CollectionView x:Name="AdvisersCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="5" Padding="10" BorderColor="Gray" HasShadow="False" CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                        <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                        <Label Grid.Row="1" Text="{Binding Username}" FontSize="14" TextColor="Gray" />

                                        <StackLayout Grid.Row="2" Orientation="Horizontal" Spacing="5">
                                            <Label Text="Status:" FontAttributes="Bold" />
                                            <Label Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" />
                                        </StackLayout>

                                        <StackLayout Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalOptions="End" Margin="0,5,0,0">

                                            <Button Text="Edit"
                                                    BackgroundColor="green"
                                                    TextColor="White"
                                                    CornerRadius="6"
                                                    HeightRequest="35"
                                                    FontSize="12"
                                                    Clicked="OnEditAdviserClicked"
                                                    BindingContext="{Binding .}" />

                                            <Button Text="{Binding IsActive, Converter={StaticResource BoolToActionConverter}}"
                                                    BackgroundColor="#8B0000"
                                                    TextColor="White"
                                                    CornerRadius="6"
                                                    HeightRequest="35"
                                                    FontSize="12"
                                                    BindingContext="{Binding .}"
                                                    Clicked="OnToggleStatusClicked" />

                                            <Button Text="Delete"
                                                    BackgroundColor="#D32F2F"
                                                    TextColor="White"
                                                    CornerRadius="6"
                                                    HeightRequest="35"
                                                    FontSize="12"
                                                    BindingContext="{Binding .}"
                                                    Clicked="OnDeleteAdviserClicked" />
                                        </StackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>